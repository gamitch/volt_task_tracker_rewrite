From 9ba182d44a2ffa7655d863bb7b92556ee02805e0 Mon Sep 17 00:00:00 2001
From: "claude[bot]" <41898282+claude[bot]@users.noreply.github.com>
Date: Tue, 11 Aug 2026 20:12:25 +0000
Subject: [PATCH] Wire the release assertion into the dispatch workflow

Adds the `assert-released` job: `needs: work`, `if: always()`, its own
checkout at the default branch, `contents: read`, and one step that runs
`scripts/linear-assert-released.mjs` with the identifier passed through
`env:` rather than interpolated into `run:`.

Linear-Issue: GAM-314
---
 .github/workflows/claude-linear-dispatch.yml | 80 ++++++++++++++++++++
 1 file changed, 80 insertions(+)

diff --git a/.github/workflows/claude-linear-dispatch.yml b/.github/workflows/claude-linear-dispatch.yml
index 7a306c8..e68f917 100644
--- a/.github/workflows/claude-linear-dispatch.yml
+++ b/.github/workflows/claude-linear-dispatch.yml
@@ -409,3 +409,83 @@ jobs:
             echo "claude --resume ${{ steps.claude.outputs.session_id }}"
             echo "\`\`\`"
           } >> "$GITHUB_STEP_SUMMARY"
+
+  # GAM-314. A dispatched run that ends its turn with a subagent still in
+  # flight returns normally, so `work` above goes green while the issue it
+  # was working sits `In Progress` with the chain unfinished — measured four
+  # times (runs 31354278407, 31385764526, 31514339272, 31523233268), none of
+  # them anywhere near `--max-turns` or `timeout-minutes`. This job is the
+  # only thing in the workflow that reports that condition; without it a
+  # green tick is the only signal anyone sees, and it is the wrong one.
+  #
+  # NOT a turn-budget or clock fix. It changes nothing about when `work`
+  # stops; it only checks, after the fact, where the issue was left. Raising
+  # either budget above would not have caught any of the four measured runs.
+  #
+  # NOT "a PR exists". A correct refusal to proceed (the `work` prompt above
+  # explicitly invites one, and item 26 rewards a premise check that stops
+  # rather than builds on a false premise) leaves no PR at all, and must not
+  # fail this job — that is exactly why the check reads the issue's Linear
+  # state rather than the run's own artifacts.
+  #
+  # `In Progress` fails even when `work` stopped deliberately. The prompt
+  # above (see "near the wall clock") tells an agent to stop, push what
+  # exists, and say so — which ends `work` green with the issue legitimately
+  # `In Progress`. That run is still an unfinished chain nobody will
+  # re-dispatch, and this job fails it anyway: a green tick on it is exactly
+  # the false-success reading GAM-314 is about. Two more shapes end the same
+  # way and are not bugs either — an escalation to the human owner under the
+  # premise-gate cap or the Loop Limit, or the workspace's own "On open in
+  # coding tool -> started" Linear automation moving a row back on its own —
+  # and `scripts/linear-assert-released.mjs` names all three so nobody reads
+  # a red run here as this check being broken.
+  assert-released:
+    name: ${{ github.event.client_payload.identifier }} — claim released
+    needs: work
+    # `always()`, not a plain `needs:`, because the run this exists to catch
+    # is a GREEN one — a plain `needs:` already covers that headline case.
+    # `always()` additionally runs this job when `work` failed or was
+    # cancelled by its `timeout-minutes`. Cite GitHub's documented `always()`
+    # semantics for this, not this repository: the one cancelled run measured
+    # here (31358757094) shows its post-steps `skipped` under a different,
+    # unrelated guard, which proves nothing either way about this job.
+    # Note the limit honestly: when `work` is cancelled, the *run's* overall
+    # conclusion is `cancelled` regardless of what this job reports, so on
+    # that path this buys a red job and a Step Summary line, not a red run.
+    if: always() && github.event.client_payload.identifier != ''
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    # Nothing more than this. This job does not inherit `work`'s
+    # `contents/pull-requests/issues: write` — it only ever reads Linear.
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@v6
+      # A separate job with its own checkout, not a step appended to `work`.
+      # `work` has held `contents: write` and unrestricted Bash over that
+      # workspace for up to 120 minutes; running the evidence-honesty check
+      # inside the tree it is judging is the wrong shape — concretely, an
+      # agent that left the tree on a ref predating this script would produce
+      # `ERR_MODULE_NOT_FOUND` -> exit 1 -> a red job for no reason. On
+      # `repository_dispatch`, `actions/checkout` takes the DEFAULT BRANCH, so
+      # this job always runs `main`'s copy of the assertion regardless of what
+      # `work` did to its own checkout.
+      - name: Assert the run released its claim
+        env:
+          LINEAR_API_KEY: ${{ secrets.LINEAR_DISPATCH_API_KEY }}
+          # The identifier goes through `env:`, never interpolated into
+          # `run:`. `client_payload` is attacker-controllable — the `work`
+          # job's own `if:` guard above exists because "anyone able to fire a
+          # `repository_dispatch` reaches this file directly" — so
+          # `run: node … ${{ github.event.client_payload.identifier }}` would
+          # be a shell-injection sink. (Contrast "Record the session id"
+          # above, which interpolates `steps.claude.outputs.session_id` — a
+          # STEP OUTPUT, not attacker-controlled payload data — directly into
+          # a `run:` block; that is safe there for a different reason and is
+          # not a pattern to copy to `client_payload`.)
+          ISSUE_IDENTIFIER: ${{ github.event.client_payload.identifier }}
+        # No `npm ci`. `scripts/linear/client.mjs` uses global `fetch` and
+        # imports nothing, so this runs on the runner's stock Node — adding an
+        # install step would put a minute and a dependency graph between a
+        # failure and its report.
+        run: node scripts/linear-assert-released.mjs "$ISSUE_IDENTIFIER"
-- 
